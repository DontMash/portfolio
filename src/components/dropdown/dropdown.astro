---
import { buttonVariant } from '@/components/content/button';
import { Icon } from '@/components/content/icon';
---

<div
  class='relative'
  x-data='collapsible'
  x-id='["dropdown-button"]'
  @keydown.escape.prevent.stop='close($refs.button)'
  @focusin.window='!$refs.panel.contains($event.target) && close()'
>
  <button
    class:list={[buttonVariant({ kind: 'link', intent: 'primary' })]}
    type='button'
    x-ref='button'
    x-bind:aria-expanded='state'
    x-bind:aria-controls='$id("dropdown-button")'
    @click='toggle'
  >
    <slot name='button' />
    <Icon
      name='tabler:caret-down'
      class='transition data-[open]:rotate-180'
      x-bind:data-open='state'
    />
  </button>

  <div
    class='absolute right-0 mt-2 w-full min-w-40 border-3 bg-(--color-background)'
    x-ref='panel'
    x-bind:id='$id("dropdown-button")'
    x-show='state'
    x-transition
    x-cloak
    @click.outside='close($refs.button)'
  >
    <slot />
  </div>
</div>
