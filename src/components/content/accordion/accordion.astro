---
import AccordionEnhancer from './accordion-enhancer';

type Props = {
  multiple?: boolean;
};

const { multiple = false } = Astro.props;
const rootId = `accordion-${crypto.randomUUID()}`;
---

<div
  id={rootId}
  data-accordion
  data-accordion-multiple={multiple ? 'true' : 'false'}
  class='flex w-full flex-col gap-4'
>
  <slot />
  <AccordionEnhancer client:visible {rootId} />
</div>
