---
import { Icon } from '@/components/content/icon';

type HeadingOption = 'heading-2' | 'heading-3' | 'heading-4';
type Props = { title: string; heading: HeadingOption };

const { title, heading } = Astro.props;
const headings: Record<HeadingOption, string> = {
  'heading-2': 'h2',
  'heading-3': 'h3',
  'heading-4': 'h4',
};
const Heading = headings[heading];
---

<div
  x-data='collapsible'
  x-id='["accordion-item-button", "accordion-item-content"]'
>
  <Heading class:list={['m-0!']}>
    <button
      class='group paragraph-highlight relative flex w-full cursor-pointer gap-4 border-b-3 p-4 text-left after:absolute after:top-[calc(100%+3px)] after:right-0 after:left-1 after:h-[3px] after:w-full after:bg-(--color-primary) focus-visible:outline-3 focus-visible:outline-current focus-visible:outline-dashed'
      type='button'
      x-bind:id='$id("accordion-item-button")'
      x-bind:data-state='state'
      x-bind:aria-expanded='state'
      x-bind:aria-controls='$id("accordion-item-content")'
      x-init='!multiple && $watch("current", (value) => value !== $id("accordion-item-button") && close())'
      @click='() => { current = $id("accordion-item-button"); toggle(); }'
    >
      <span>{title}</span>
      <Icon
        class='ml-auto min-w-fit self-end transition group-data-state:rotate-180'
        name='tabler:caret-down'
      />
    </button>
    <Heading />

    <section
      role='region'
      x-bind:id='$id("accordion-item-content")'
      x-show='state'
      x-cloak
      x-collapse
      x-bind:aria-labelledby='$id("accordion-item-button")'
    >
      <div class='px-4 pt-4 *:first:mt-0 *:last:mb-0'>
        <slot />
      </div>
    </section>
  </Heading>
</div>
