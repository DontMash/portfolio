---
import {
  getPageEntryPath,
  getPageId,
  getPagePath,
} from '@/collections/page.collection';
import { isProductionOrigin } from '@/utils';

import Toolbar from '@/components/page/toolbar';

const { locale, slug } = Astro.params;
const id = getPageId(locale, slug);
const path = getPagePath(id);
const entryPath = getPageEntryPath(locale, slug);
const editHref = import.meta.env.DEV
  ? entryPath
  : new URL(entryPath, Astro.site).toString();
const dashboardHref = import.meta.env.DEV
  ? '/keystatic'
  : new URL('keystatic/branch/preview', Astro.site).toString();
const localHref = import.meta.env.DEV
  ? undefined
  : new URL(path, 'http://localhost:4321').toString();
---

{
  !isProductionOrigin(Astro.url, Astro.site) && (
    <Toolbar
      client:load
      editHref={editHref}
      dashboardHref={dashboardHref}
      localHref={localHref}
    />
  )
}
