---
import { getEntry } from 'astro:content';

import { getPagePath } from '@/collections/page.collection';
import { navigationSchema } from '@/collections/navigation.schema';
import navigationContent from '@/content/navigation.json';
import {
  defaultLocale,
  getLabelForLocale,
  useTranslation,
  type LocaleCode,
} from '@/i18n';

import { Button, buttonVariant } from '@/components/content/button';
import { Dropdown, dropdownItemVariant } from '@/components/dropdown';
import Logo from '@/components/logo.astro';
import { Icon } from '@/components/content/icon';

const currentLocale =
  (Astro.currentLocale as LocaleCode | undefined) ?? defaultLocale;
const t = useTranslation(currentLocale);

const { locale, slug } = Astro.params;
const page = await getEntry('pages', slug ? `${locale}/${slug}` : `${locale}`);

const navigation = navigationSchema.safeParse(navigationContent);
const navigationItems =
  navigation.success &&
  navigation.data.header.filter((item) => item.locale === currentLocale);
---

<header
  class='sticky top-0 left-0 z-50 border-b-3 bg-(--color-background)'
  role='banner'
>
  <nav
    class='mx-auto flex h-20 max-w-screen-xl items-center px-4 sm:px-12 xl:border-x-3'
    aria-label={t('header.nav.label')}
    x-data='{ theme: $store.theme.get()}'
    x-init='$watch("$store.theme.state", (value) => (theme = $store.theme.get()))'
  >
    <Logo />

    {
      navigationItems && navigationItems.length > 0 && (
        <ul class='ml-12 hidden h-full divide-x-3 border-x-3 lg:flex'>
          {navigationItems.map((item) => {
            const link = item.links.at(0);
            if (!link) return null;

            if (item.links.length < 2) {
              return (
                <li class='flex h-full items-center px-4'>
                  <a
                    class:list={[buttonVariant({ kind: 'link' })]}
                    href={`/${getPagePath(link.page.id)}${link.params ?? ''}`}
                  >
                    {item.title}
                  </a>
                </li>
              );
            }

            return (
              <li class='flex h-full items-center px-4'>
                <Dropdown>
                  <Fragment slot='button'>{item.title}</Fragment>

                  {item.links.map(async (link) => (
                    <a
                      class:list={[dropdownItemVariant()]}
                      href={`/${getPagePath(link.page.id)}${link.params ?? ''}`}
                    >
                      {(await getEntry('pages', link.page.id))?.data.title}
                    </a>
                  ))}
                </Dropdown>
              </li>
            );
          })}
        </ul>
      )
    }

    <div class='ml-auto flex items-center gap-4'>
      <Dropdown>
        <Fragment slot='button'>
          <Icon name='tabler:contrast-filled' />
          <span class='sr-only' x-text='$store.theme.get()'></span>
        </Fragment>

        <button
          class:list={[dropdownItemVariant()]}
          @click='$store.theme.set("light")'
        >
          <Icon name='tabler:sun' />
          <span>Light</span>
          <Icon
            class='ml-auto'
            name='tabler:check'
            x-show='$store.theme.state === "light"'
          />
        </button>
        <button
          class:list={[dropdownItemVariant()]}
          @click='$store.theme.set("dark")'
        >
          <Icon name='tabler:moon' />
          <span>Dark</span>
          <Icon
            class='ml-auto'
            name='tabler:check'
            x-show='$store.theme.state === "dark"'
          />
        </button>
        <button
          class:list={[dropdownItemVariant()]}
          @click='$store.theme.set("auto")'
        >
          <Icon name='tabler:device-desktop' />
          <span>Auto</span>
          <Icon
            class='ml-auto'
            name='tabler:check'
            x-show='$store.theme.state === "auto"'
          />
        </button>
      </Dropdown>

      {
        page && page.data.locales.length && (
          <Dropdown>
            <Fragment slot='button'>
              <Icon name='tabler:language' />
              <span class='sr-only'>{getLabelForLocale(currentLocale)}</span>
            </Fragment>

            <span class:list={[dropdownItemVariant()]}>
              {getLabelForLocale(currentLocale)}
              <Icon class='ml-auto' name='tabler:check' />
            </span>
            {page?.data.locales.map((entry) => (
              <a
                class:list={[dropdownItemVariant()]}
                href={`/${getPagePath(entry.ref)}`}
              >
                {getLabelForLocale(entry.locale)}
              </a>
            ))}
          </Dropdown>
        )
      }

      <Button class='!hidden lg:!inline-block' href={`/${Astro.currentLocale}#form`}>
        <Icon name='tabler:at' />
        <span>{t('header.nav.cta')}</span>
      </Button>

      <Button class='inline-block lg:hidden' href={`/${Astro.currentLocale}#form`}>
        <Icon name='tabler:menu-2' />
        <span>{t('header.nav.menu')}</span>
      </Button>
    </div>
  </nav>
</header>
