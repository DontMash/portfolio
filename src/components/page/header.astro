---
import { getEntry } from 'astro:content';

import { getPagePath } from '@/collections/page.collection';
import {
  defaultLocale,
  getLabelForLocale,
  useTranslation,
  type LocaleCode,
} from '@/i18n';

import { buttonVariant } from '@/components/ui/button';
import { Icon } from '@/components/content/icon';
import Logo from '@/components/logo.astro';
import LocaleMenu from '@/components/page/locale-menu';
import ThemeMenu from '@/components/page/theme-menu';

const currentLocale =
  (Astro.currentLocale as LocaleCode | undefined) ?? defaultLocale;
const t = useTranslation(currentLocale);

const { locale, slug } = Astro.params;
const page = await getEntry('pages', slug ? `${locale}/${slug}` : `${locale}`);
const localeOptions = page?.data.locales.map((entry) => ({
  label: getLabelForLocale(entry.locale),
  href: `/${getPagePath(entry.ref)}`,
  current: entry.locale === currentLocale,
}));
---

<header
  class='sticky top-0 left-0 z-(--z-header) border-b-3 bg-(--color-background)'
  role='banner'
>
  <nav
    class='mx-auto flex h-20 max-w-screen-xl items-center px-4 sm:px-12'
    aria-label={t('header.nav.label')}
  >
    <Logo />

    <div class='ml-auto flex items-center gap-4'>
      <ThemeMenu client:load />

      {
        localeOptions && localeOptions.length > 0 && (
          <LocaleMenu
            client:load
            currentLabel={getLabelForLocale(currentLocale)}
            options={localeOptions}
          />
        )
      }

      <div class='hidden sm:block'>
        <a
          class:list={[buttonVariant()]}
          href={`/${Astro.currentLocale}/#form`}
        >
          <Icon name='tabler:at' />
          <span>{t('header.nav.cta')}</span>
        </a>
      </div>
    </div>
  </nav>
</header>
