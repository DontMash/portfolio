---
import logoDark from '@/assets/icons/logomark_dark.svg';
import logoLight from '@/assets/icons/logomark_light.svg';

import { defaultLocale, useTranslation, type LocaleCode } from '@/i18n';
import { buttonVariant } from '@/components/ui/button';

type Props = {
  invert?: boolean;
};

const { invert = false } = Astro.props;
const t = useTranslation((Astro.currentLocale as LocaleCode) ?? defaultLocale);
---

<a
  class:list={['-mb-4', buttonVariant({ kind: 'link' })]}
  href={`/${Astro.currentLocale}`}
  data-theme-logo={invert ? 'invert' : undefined}
>
  <img
    class='theme-logo-light'
    src={logoLight.src}
    alt=''
    width='132'
    height='48'
  />
  <img
    class='theme-logo-dark'
    src={logoDark.src}
    alt=''
    width='132'
    height='48'
  />
  <span class='sr-only'>{t('logo.href.label')}</span>
</a>
