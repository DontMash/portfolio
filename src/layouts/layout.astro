---

<!doctype html>
<!--
Handcrafted with Astro, TailwindCSS, AlpineJS & KeystaticCMS.
Managed & hosted on Hetzner in Germany.
Interested to see how it works for you?
https://www.soren.codes#contact
-->
<html lang={Astro.currentLocale} x-data x-bind:data-theme='$store.theme.get()'>
  <head>
    <SEO {...Astro.props.seo} />
    <Theme />
    <Analytics />
    <Motd />
  </head>
  <body id='top'>
    <Header />

    <main
      class='dots prose dark:prose-p:text-base-300 prose-a:anchor prose-hr:border-t-3 prose-img:w-full prose-kbd:bg-(--color-background) prose-kbd:border-3 prose-kbd:border-(--color-foreground) prose-p:text-base-600 prose-h1:heading-1 prose-h2:heading-2 prose-h3:heading-3 prose-h4:heading-4 prose-h5:heading-5 prose-h6:heading-6 mx-auto flex min-h-screen max-w-screen-xl flex-col divide-y-3 xl:border-x-3'
      role='main'
    >
      <Breadcrumb />

      <slot />
    </main>

    <Toolbar />

    <Footer />
  </body>
</html>

<style is:global>
  /* azeret-mono-latin-wght-normal */
  @font-face {
    font-family: 'Azeret Mono Variable';
    font-style: normal;
    font-display: swap;
    font-weight: 100 900;
    src: url(@fontsource-variable/azeret-mono/files/azeret-mono-latin-wght-normal.woff2)
      format('woff2-variations');
    unicode-range:
      U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
      U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193,
      U+2212, U+2215, U+FEFF, U+FFFD;
  }
</style>
